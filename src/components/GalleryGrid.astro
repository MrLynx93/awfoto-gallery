---
/**
 * The client's photo grid.
 *
 * Adapted from awfoto-site's PhotoGallery.astro, which uses `astro:assets` —
 * that cannot work here, because these photos are runtime uploads rather than
 * build-time assets. Astro never sees them, so the markup is a plain <img>
 * pointing at the authenticated preview route and the derivatives are made by
 * the worker instead of by the build.
 *
 * The `data-lightbox-index` and `#photo-grid` contract is kept exactly, so
 * Lightbox.astro works unchanged.
 *
 * ## Masonry, not justified rows
 *
 * This used to pack photos into justified rows -- Flickr/Google Photos style,
 * every line filling the width at one shared height. That made photos bigger
 * than a plain square grid, but a row is still a row: a portrait next to a
 * panorama meant the whole line was capped by whichever one fit last, and
 * "photos should be bigger, and they don't have to share a height" is asking
 * for the row itself to go.
 *
 * So this is a CSS multi-column layout instead: fixed-width columns, each
 * photo shown at its own true aspect ratio -- there is no row for it to
 * match anymore, so nothing forces one. `columns` plus `break-inside: avoid`
 * is the whole layout; the browser decides how many columns fit and stacks
 * each photo under the shortest one, same as it decided line breaks before.
 * Nothing here measures or recomputes on resize.
 *
 * No cropping happens in the normal case: the box is sized from the exact
 * ratio the manifest recorded, so the image fills it exactly. `object-fit:
 * cover` on the `<img>` is only a safety net for when that ratio is wrong --
 * a manifest entry left over from a photo that used to occupy this index,
 * say -- and would otherwise stretch or squash the image into a shape it was
 * never shot at, which looks broken in a way a slight, invisible-in-practice
 * crop does not.
 *
 * The trade a masonry column always makes: reading order runs down one
 * column before starting the next, not left-to-right across a row. A
 * justified row keeps chronological order strictly left-to-right; a column
 * layout does not. That is the cost of letting heights differ instead of
 * matching them, and it is what was asked for.
 */
interface PhotoMeta {
  /** From the manifest. Null for a photo the worker could not measure. */
  width?: number | null;
  height?: number | null;
}

interface Props {
  slug: string;
  /** The manifest's photos, in order -- a photo's identity is its position. */
  photos: PhotoMeta[];
  /**
   * The panel passes this; the client's page never does. It puts a small × on
   * each photo, posting to the page it sits on -- a plain form, so it works
   * without JavaScript, and an inline script asks first when there is any.
   */
  deletable?: boolean;
}

const { slug, photos, deletable = false } = Astro.props;
const count = photos.length;

/**
 * What to assume when the manifest has no dimensions -- only reserves space
 * before the image loads, so a slightly-off guess costs a moment of layout
 * shift and nothing else. Landscape, because most of a session is, and this
 * is only ever reached by a gallery prepared before the worker started
 * recording proportions.
 */
const FALLBACK_RATIO = 1.5;

/**
 * Unclamped, deliberately: there is no row for an extreme ratio to break
 * anymore, and cropping is gone along with it, so clamping would only mean
 * stretching a photo to a ratio it was never shot at. Shown as tall or as
 * wide as it actually is, always.
 */
function ratioOf(photo: PhotoMeta): number {
  const width = Number(photo?.width);
  const height = Number(photo?.height);
  if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
    return FALLBACK_RATIO;
  }
  return width / height;
}

const tiles = photos.map((photo, index) => ({ index, ratio: ratioOf(photo).toFixed(3) }));
---

<div class="grid-frame">
  {/* data-slug: Lightbox.astro reads it to build the download link for
      whichever photo is showing -- /g/:slug/photo/:index, the one route that
      serves an original rather than a preview. */}
  <div class="photo-grid" id="photo-grid" data-slug={slug}>
    {/* The panel puts its drop zone here, as the first card in the grid: adding
        photos belongs among the photos rather than in a panel above them. The
        client's page passes nothing, so the grid starts at the first photograph. */}
    <slot name="lead" />

    {
      tiles.map(({ index, ratio }) => (
        <div class="tile" style={`--ar: ${ratio}`}>
          <button
            class="photo"
            type="button"
            data-lightbox-index={index}
            aria-label={`Powiększ zdjęcie ${index + 1} z ${count}`}
          >
            <img
              src={`/g/${slug}/p/${index}/thumb.jpg`}
              srcset={`/g/${slug}/p/${index}/thumb.jpg 500w, /g/${slug}/p/${index}/large.jpg 2048w`}
              sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, min(26vw, 24rem)"
              alt={`Zdjęcie ${index + 1}`}
              loading={index < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>

          {deletable && (
            /* A form rather than a button with a fetch behind it: this page
               already answers POSTs, and it keeps working with no JavaScript.
               The index is the photo's identity -- see server/photos.js. */
            <form class="remove" method="POST" data-confirm={`Usunąć zdjęcie ${index + 1}?`}>
              <input type="hidden" name="intent" value="delete-photo" />
              <input type="hidden" name="index" value={index} />
              <button type="submit" aria-label={`Usuń zdjęcie ${index + 1}`} title="Usuń to zdjęcie">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 6 12 12M18 6 6 18" />
                </svg>
              </button>
            </form>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  /* Exists to be measured: `cqw` below asks how wide the grid is, and an
     element cannot ask that of itself. The panel's grid sits inside a card and
     the client's fills the page, so the same viewport gives them very different
     room -- which a `vw` here would miss, sizing the panel's columns for a
     width they do not have. */
  .grid-frame {
    container-type: inline-size;
  }

  .photo-grid {
    /* Gap between columns and, via each tile's own margin below, between
       photos stacked in the same column -- multi-column layout has no
       `row-gap` of its own, so the vertical half of this is spent there
       instead of here. One custom property so the two stay equal. */
    --gap: clamp(0.5rem, 1.4vw, 1rem);

    /* Column width is the whole lever for "bigger": more of it here is
       fewer, larger columns; less is more, smaller ones. A quarter of the
       grid's own width lands on three or four columns at a laptop and one
       or two on a phone -- noticeably larger per photo than the fifth a
       justified row spent on a single tile, since a column does not also
       have to leave room for whatever else shares its line. The floor keeps
       a phone at something more than a fragment of a photo; the ceiling
       stops a wide monitor turning a photo into a poster off a 2048px
       preview. */
    column-width: clamp(11rem, 26cqw, 24rem);
    column-gap: var(--gap);
  }

  .tile,
  /* The panel's drop zone, slotted in from outside this component -- a
     descendant rather than a child, because Astro wraps an island in
     <astro-island> and `display: contents` hides it from the layout without
     removing it from the tree. */
  .photo-grid :global(.uploader-card) {
    /* Multi-column layout otherwise feels free to split one photo's box
       across the bottom of one column and the top of the next. */
    break-inside: avoid;
    margin-bottom: var(--gap);
  }

  /* The drop zone is not a photo and carries no --ar of its own, so it needs
     an explicit shape rather than inheriting one -- landscape, the same
     fallback a photo with no recorded dimensions gets. Uppy's Dashboard
     fills it via `height: 100%` (editor.css), which needs this box to have a
     real height to be a percentage of. */
  .photo-grid :global(.uploader-card) {
    aspect-ratio: 1.5;
    height: auto;
  }

  /* Small, in the corner, and quiet until she goes near it: this sits on top of
     a photograph and is not what the grid is for. It fills red on hover so
     there is no doubt what it does. */
  .remove {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    margin: 0;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .tile:hover .remove,
  .remove:focus-within { opacity: 1; }

  .remove button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(253, 251, 247, 0.9);
    color: var(--tekst);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .remove button:hover,
  .remove button:focus-visible {
    background: var(--czerwien);
    color: var(--biel);
  }
  .remove svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .tile {
    /* Multi-column layout lays tiles out as if the column were a page, top
       to bottom -- `position: relative` is what lets the × still pin itself
       to its own photo's corner rather than the column's. */
    position: relative;
  }

  .photo {
    padding: 0;
    /* A hairline, so a light photograph has an edge rather than bleeding into
       the cream behind it. */
    border: 1px solid var(--piaskowy);
    background: var(--bez);
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 3px;
    display: block;
    width: 100%;
  }
  .photo img {
    /* The aspect-ratio reserves the photo's true shape before it loads --
       there is no cropping left to do when --ar is right, so the image is
       simply shown at the width its column gives it and whatever height
       that ratio implies. `object-fit: cover` is a safety net for when it
       is not: a manifest entry that does not match the file it describes
       (a stale one carried over from a photo that used to sit at this
       index, say) would otherwise squash or stretch the image to fit a box
       shaped for a different photo, which reads as broken in a way a slight
       crop does not. Invisible whenever --ar is correct, since a box sized
       to the image's own ratio needs no cropping to fill it. */
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar, 1.5);
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0.2, 1);
  }
  .photo:hover img {
    transform: scale(1.04);
  }
  .photo:focus-visible {
    outline: 2px solid var(--glina);
    outline-offset: 3px;
  }

  /* A finger cannot hover, so on a touch screen the button is simply there. */
  @media (hover: none) {
    .remove { opacity: 1; }
  }
</style>

{/* Asks before it submits, and only where the × exists at all. Without
    JavaScript the form still posts -- one deliberate click on a small target,
    which is the trade the client's page never sees. */}
<script is:inline>
  document.getElementById('photo-grid')?.addEventListener('submit', (event) => {
    const form = event.target.closest('.remove[data-confirm]');
    if (form && !window.confirm(`${form.dataset.confirm} Tego nie da się cofnąć.`)) {
      event.preventDefault();
    }
  });
</script>
