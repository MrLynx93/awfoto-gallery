---
/**
 * The "are you sure?" itself: what will be destroyed, said plainly, with the
 * two buttons under it.
 *
 * Shared by every place that asks, in one of two frames. Given `dialogId` it is
 * a modal, which is what both screens that already list the gallery use: the
 * question is about something she is looking at, and sending her to another
 * page to answer it -- then landing her on the list whether she says yes or no
 * -- loses her place for nothing. Without it, it is the body of the standalone
 * page, which is where the no-JavaScript path ends up and what the modal's
 * trigger links to before any script runs.
 *
 * Naming the client inside the modal is what makes it safe on the dashboard: a
 * list of nine similar rows is exactly where the wrong gallery gets deleted, so
 * the dialog repeats which one she picked rather than asking "are you sure?"
 * about nothing in particular.
 *
 * Either way it is a form and a POST: no JavaScript required to answer it, and
 * nothing deletes a wedding by being prefetched or crawled.
 */
import { daysUntil } from '../../server/gallery-form.js';
import { dayCount, megabytes } from '../../server/format.js';

interface Props {
  gallery: {
    sessionName: string;
    shootDate?: string | null;
    photoCount: number;
    bytesTotal: number;
    expiresAt: string;
  };
  /**
   * What "no" says, and where it goes. With `href` it is a link to another
   * screen; without one it closes the dialog it is in -- `formmethod="dialog"`
   * does that natively, so even that button needs no script.
   */
  cancel: { label: string; href?: string };
  /** Where the form posts. Omitted to post to the page it is rendered on. */
  action?: string;
  /** Given, this renders as a modal with that id; omitted, as a bare body. */
  dialogId?: string;
}

const { gallery, cancel, action, dialogId } = Astro.props;

// A <dialog> when it is a modal, a plain wrapper when the page is the frame.
// Astro renders a capitalised variable holding a tag name as that element.
const Frame = dialogId ? 'dialog' : 'div';

// expires_at is NOT NULL, so the fallback is unreachable; it is here because
// daysUntil answers null for a gallery with no date and this file should not
// pretend otherwise.
const left = daysUntil(gallery.expiresAt) ?? 0;
---

<Frame id={dialogId} aria-labelledby={dialogId && `${dialogId}-title`}>
  {dialogId && <h2 id={`${dialogId}-title`}>Usunąć tę galerię?</h2>}

  <dl class="what">
    <div>
      <dt>Sesja</dt>
      <dd>{gallery.sessionName}</dd>
    </div>
    <div>
      <dt>Data sesji</dt>
      <dd>{gallery.shootDate ?? '—'}</dd>
    </div>
    <div>
      <dt>Zdjęcia</dt>
      <dd>{gallery.photoCount} ({megabytes(gallery.bytesTotal)})</dd>
    </div>
    <div>
      <dt>Termin</dt>
      <dd>{left > 0 ? `jeszcze ${dayCount(left)}` : 'już minął'}</dd>
    </div>
  </dl>

  <p class="warn" role="alert">
    Zniknie link klienta i wszystkie zdjęcia z serwera. Tego nie da się cofnąć —
    jeśli nie masz ich już nigdzie indziej, trzeba będzie wysłać je od nowa.
  </p>

  <form method="POST" action={action} class="actions">
    <input type="hidden" name="intent" value="delete-gallery" />
    <button type="submit" class="danger">Tak, usuń galerię</button>
    {
      cancel.href ? (
        <a class="cancel" href={cancel.href}>
          {cancel.label}
        </a>
      ) : (
        <button type="submit" class="cancel" formmethod="dialog" formnovalidate>
          {cancel.label}
        </button>
      )
    }
  </form>
</Frame>

<style>
  /* The modal's own chrome. Scoped here rather than repeated on each page that
     opens one, so every dialog in the panel is the same object. */
  dialog {
    /* Wide enough for the two buttons to sit side by side rather than stack:
       at 32rem they missed by a couple of pixels. */
    width: min(34rem, calc(100% - 2rem));
    padding: clamp(1.4rem, 4vw, 2rem);
    border: 1px solid var(--piaskowy);
    border-radius: 4px;
    background: var(--kremowy);
    color: var(--tekst);
  }
  dialog::backdrop { background: rgba(74, 64, 56, 0.45); }
  dialog h2 { margin: 0 0 1.4rem; }

  .what {
    margin: 0 0 2rem;
    border-top: 1px solid var(--piaskowy);
  }
  .what div {
    display: flex; justify-content: space-between; gap: 1.5rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--bez);
  }
  dt {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tekst-jasny);
  }
  dd { margin: 0; text-align: right; }

  /* Red rather than clay: this is the sentence that says the photographs are
     going, and in the panel's warm palette a beige box reads as a note. */
  .warn {
    background: #fbeae8; border: 1px solid #e9bdb7; border-radius: 4px;
    padding: 1rem 1.2rem; margin: 0 0 2rem; color: var(--czerwien-ciemna);
  }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; }

  /* The destructive button is the one that looks unlike every other button in
     the panel: filled, and in a colour used nowhere else. */
  .danger {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border-radius: 3px;
    /* Transparent rather than none: the outlined button beside it has a real
       1px border, and without this the filled one is two pixels shorter. */
    border: 1px solid transparent;
    background: var(--czerwien); color: var(--biel); cursor: pointer;
    /* Stated on both, so a <button> and an <a> side by side come out the same
       height: a button's default line-height is `normal` and an anchor inherits
       the body's 1.75, and the two sat six pixels apart. */
    line-height: 1.2;
    transition: background 0.25s;
  }
  .danger:hover { background: var(--czerwien-ciemna); }

  /* A button too, not a passing link: it sits next to the destructive one and
     is the choice most likely to be wanted, so it has to look like something to
     press. Outlined rather than filled, so the two are still told apart. */
  .cancel {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border-radius: 3px;
    border: 1px solid var(--taupe); background: transparent;
    color: var(--tekst); text-decoration: none; line-height: 1.2; cursor: pointer;
    transition: background 0.25s, border-color 0.25s;
  }
  .cancel:hover { background: var(--piaskowy); border-color: var(--piaskowy); }
</style>
