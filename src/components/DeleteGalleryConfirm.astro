---
/**
 * The "are you sure?" itself: what will be destroyed, said plainly, with the
 * two buttons under it.
 *
 * Shared by every place that asks, in one of two frames. Given `dialogId` it is
 * a modal, which is what both screens that already list the gallery use: the
 * question is about something she is looking at, and sending her to another
 * page to answer it -- then landing her on the list whether she says yes or no
 * -- loses her place for nothing. Without it, it is the body of the standalone
 * page, which is where the no-JavaScript path ends up and what the modal's
 * trigger links to before any script runs.
 *
 * Naming the client inside the modal is what makes it safe on the dashboard: a
 * list of nine similar rows is exactly where the wrong gallery gets deleted, so
 * the dialog repeats which one she picked rather than asking "are you sure?"
 * about nothing in particular.
 *
 * Either way it is a form and a POST: no JavaScript required to answer it, and
 * nothing deletes a wedding by being prefetched or crawled.
 */
import { daysUntil } from '../../server/gallery-form.js';
import { dayCount, megabytes } from '../../server/format.js';
// The box, the red sentence and the two buttons, shared with the dialog that
// asks about one photo -- imported here rather than by each page, so both
// frames below are dressed wherever they are rendered.
import '../styles/dialog.css';

interface Props {
  gallery: {
    sessionName: string;
    sessionDate?: string | null;
    photoCount: number;
    bytesTotal: number;
    expiresAt: string;
  };
  /**
   * What "no" says, and where it goes. With `href` it is a link to another
   * screen; without one it closes the dialog it is in -- `formmethod="dialog"`
   * does that natively, so even that button needs no script.
   */
  cancel: { label: string; href?: string };
  /** Where the form posts. Omitted to post to the page it is rendered on. */
  action?: string;
  /** Given, this renders as a modal with that id; omitted, as a bare body. */
  dialogId?: string;
}

const { gallery, cancel, action, dialogId } = Astro.props;

// A <dialog> when it is a modal, a plain wrapper when the page is the frame.
// Astro renders a capitalised variable holding a tag name as that element.
const Frame = dialogId ? 'dialog' : 'div';

// expires_at is NOT NULL, so the fallback is unreachable; it is here because
// daysUntil answers null for a gallery with no date and this file should not
// pretend otherwise.
const left = daysUntil(gallery.expiresAt) ?? 0;
---

<Frame
  id={dialogId}
  class={dialogId ? 'panel-dialog' : undefined}
  aria-labelledby={dialogId && `${dialogId}-title`}
>
  {dialogId && <h2 id={`${dialogId}-title`}>Usunąć tę galerię?</h2>}

  <dl class="what">
    <div>
      <dt>Sesja</dt>
      <dd>{gallery.sessionName}</dd>
    </div>
    <div>
      <dt>Data sesji</dt>
      <dd>{gallery.sessionDate ?? '—'}</dd>
    </div>
    <div>
      <dt>Zdjęcia</dt>
      <dd>{gallery.photoCount} ({megabytes(gallery.bytesTotal)})</dd>
    </div>
    <div>
      <dt>Termin</dt>
      <dd>{left > 0 ? `jeszcze ${dayCount(left)}` : 'już minął'}</dd>
    </div>
  </dl>

  <p class="dialog-warn" role="alert">
    Zniknie link klienta i wszystkie zdjęcia z serwera. Tego nie da się cofnąć —
    jeśli nie masz ich już nigdzie indziej, trzeba będzie wysłać je od nowa.
  </p>

  <form method="POST" action={action} class="dialog-actions">
    <input type="hidden" name="intent" value="delete-gallery" />
    <button type="submit" class="dialog-confirm">Tak, usuń galerię</button>
    {
      cancel.href ? (
        <a class="dialog-cancel" href={cancel.href}>
          {cancel.label}
        </a>
      ) : (
        <button type="submit" class="dialog-cancel" formmethod="dialog" formnovalidate>
          {cancel.label}
        </button>
      )
    }
  </form>
</Frame>

<style>
  /* What is left here is this question's own body -- the chrome around it, and
     the two buttons under it, are in styles/dialog.css because the photo
     dialog wears the same ones. */
  .what {
    margin: 0 0 2rem;
    border-top: 1px solid var(--piaskowy);
  }
  .what div {
    display: flex; justify-content: space-between; gap: 1.5rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--bez);
  }
  dt {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tekst-jasny);
  }
  dd { margin: 0; text-align: right; }
</style>
