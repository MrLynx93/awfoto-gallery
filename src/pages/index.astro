---
/**
 * The bare domain.
 *
 * Almost every visit here is the photographer typing the address from memory,
 * so it goes straight to the panel — clients never arrive at the root, they
 * click a `/g/<slug>` link they were sent.
 *
 * A client who does land here is not left guessing: /admin bounces an
 * unauthenticated visitor to a login screen that says plainly it is for sending
 * photos, which reads as "not for you" rather than as an error.
 */
if (!Astro.cookies.has('awf_admin')) {
  return Astro.redirect('/admin/login');
}

return Astro.redirect('/admin');
---
