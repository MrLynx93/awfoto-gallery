---
/**
 * The client's gallery: the only page anyone outside the business ever sees.
 *
 * One screen, three states — the password gate, the "still preparing" wait, and
 * the grid. An expired gallery gets a warm explanation rather than a 404, per
 * CLAUDE.md: the client did nothing wrong and should not meet an error page.
 *
 * Reads the gallery from the manifest the worker writes. The database becomes
 * the index in Milestone 2; this page will change where it looks up a gallery,
 * not what it does with one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { readManifest } from '../../../server/storage.js';
import { findBySlug, isExpired } from '../../../server/galleries.js';
import { daysUntil } from '../../../server/gallery-form.js';
import { dayCount } from '../../../server/format.js';
import * as rateLimit from '../../../server/rate-limit.js';
import { verify } from '../../../server/passwords.js';
import {
  galleryCookieName,
  hasGalleryAccess,
  issueGallery,
  cookieOptions,
  GALLERY_TTL,
} from '../../../server/sessions.js';

const { slug } = Astro.params;

// The database is the index: it decides whether this gallery exists, whether it
// still lives, and what password opens it. A gallery that never existed and one
// that expired give the same page -- telling them apart only helps someone
// probing for valid slugs.
const gallery = await findBySlug(slug);
const expired = isExpired(gallery);

const cookieName = galleryCookieName(slug);
let authorised = hasGalleryAccess(Astro.cookies.get(cookieName)?.value, slug);
let wrongPassword = false;
let blockedFor = 0;

if (Astro.request.method === 'POST' && !authorised) {
  // Behind Passenger, the client address arrives in X-Forwarded-For.
  const ip =
    Astro.request.headers.get('x-forwarded-for')?.split(',')[0].trim() ||
    Astro.clientAddress;

  // Checked before the password is even looked at, and counted against the slug
  // whether or not it names a real gallery -- a scan across invented slugs is
  // exactly what this should notice.
  const allowance = await rateLimit.check(slug, ip);

  if (!allowance.allowed) {
    blockedFor = allowance.retryAfterMinutes;
  } else {
    const form = await Astro.request.formData();
    const submitted = String(form.get('password') || '');

    if (gallery && !expired && (await verify(submitted, gallery.passwordHash))) {
      await rateLimit.clear(slug, ip);
      Astro.cookies.set(cookieName, issueGallery(slug), cookieOptions(GALLERY_TTL));
      authorised = true;
    } else {
      await rateLimit.record(slug, ip);
      wrongPassword = true;
    }
  }
}

// Per-photo detail lives in the manifest the worker writes; the row above says
// whether we are allowed to look at it at all.
let photos = [];
if (authorised && gallery?.status === 'ready') {
  try {
    photos = (await readManifest(slug)).photos ?? [];
  } catch {
    // Row says ready but the manifest is unreadable -- treat it as still
    // preparing rather than showing a grid of broken images.
  }
}

const polishDate = (value: string) =>
  new Date(value).toLocaleDateString('pl-PL', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const dateLabel = gallery?.sessionDate ? polishDate(gallery.sessionDate) : null;

// How long they have. Said plainly, on the page, because the alternative is a
// client who finds out by coming back to an expired gallery -- and by then the
// photographs are gone from the server for good.
const daysLeft = gallery ? daysUntil(gallery.expiresAt) : null;
const untilLabel = gallery ? polishDate(gallery.expiresAt) : null;
---

{/* The same bar the panel wears, with no trail: this is one page, reached by a
    link, and the mark is here to say whose photographs these are rather than to
    navigate. It leads to the photographer's site, not to /admin. */}
<BaseLayout
  title={gallery?.sessionName ?? 'Galeria'}
  width={authorised ? 'photos' : 'text'}
  crumbs={[]}
  homeHref="https://aw-foto.pl"
>
  {
    !gallery || expired ? (
      <section class="message">
        <h1>Ta galeria wygasła</h1>
        <p>
          Zdjęcia są przechowywane przez ograniczony czas i te zostały już
          usunięte. Jeśli potrzebujesz ich ponownie, napisz do mnie — chętnie
          pomogę.
        </p>
        <p class="contact">
          <a href="https://aw-foto.pl/kontakt">aw-foto.pl/kontakt</a>
        </p>
      </section>
    ) : !authorised ? (
      <section class="gate">
        <h1>{gallery.sessionName}</h1>
        {dateLabel && <p class="date">{dateLabel}</p>}
        <p>Wpisz hasło, które otrzymałaś lub otrzymałeś razem z linkiem.</p>

        <form method="POST">
          <label class="visually-hidden" for="password">Hasło</label>
          <input
            id="password"
            name="password"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            required
            autofocus
            aria-describedby={wrongPassword ? 'password-error' : undefined}
          />
          <button type="submit">Otwórz galerię</button>
        </form>

        {blockedFor > 0 && (
          <p class="error" id="password-error" role="alert">
            Za dużo prób. Spróbuj ponownie za {blockedFor} min. Jeśli zgubiłaś
            lub zgubiłeś hasło — napisz do mnie, wyślę je ponownie.
          </p>
        )}
        {wrongPassword && (
          <p class="error" id="password-error" role="alert">
            Hasło się nie zgadza. Sprawdź, czy nie ma dodatkowej spacji na końcu.
          </p>
        )}
      </section>
    ) : gallery.status !== 'ready' || photos.length === 0 ? (
      <section class="message">
        <h1>Przygotowuję Twoje zdjęcia</h1>
        <p>
          Zdjęcia są już na serwerze i właśnie się przetwarzają. To zwykle kilka
          minut. Ta strona odświeży się sama.
        </p>
        <p class="contact">Możesz spokojnie zamknąć okno i wrócić później.</p>
      </section>
    ) : (
      <>
        <header class="gallery-head">
          <div>
            <h1>{gallery.sessionName}</h1>
            {dateLabel && <p class="date">{dateLabel}</p>}
          </div>
          <a class="download" href={`/g/${slug}/zip`}>
            Pobierz wszystkie ({photos.length})
          </a>
        </header>

        {daysLeft !== null && (
          <p class="until">
            Zdjęcia będą dostępne jeszcze {dayCount(daysLeft)} — do {untilLabel}.
            Potem galeria wygaśnie, więc pobierz je wcześniej.
          </p>
        )}

        <GalleryGrid slug={slug} photos={photos} />
        <Lightbox />

        <p class="hint">
          Kliknij zdjęcie, aby powiększyć. Pojedyncze zdjęcie pobierzesz
          strzałką w podglądzie.
        </p>
      </>
    )
  }
</BaseLayout>

<style>
  .message,
  .gate {
    max-width: 32rem;
    margin: clamp(2rem, 10vh, 6rem) auto;
    text-align: center;
  }

  .date {
    color: var(--tekst-jasny);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: -0.4em 0 1.6em;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 2rem auto 0;
    max-width: 18rem;
  }

  input {
    font-family: var(--body);
    font-size: 1.35rem;
    letter-spacing: 0.22em;
    text-align: center;
    text-transform: uppercase;
    padding: 0.7em 0.5em;
    border: 1px solid var(--taupe);
    border-radius: 3px;
    background: var(--biel);
    color: var(--tekst);
  }
  input:focus-visible {
    outline: 2px solid var(--glina);
    outline-offset: 2px;
    border-color: transparent;
  }

  button,
  .download {
    font-family: var(--body);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 1em 1.8em;
    border: 0;
    border-radius: 3px;
    background: var(--glina);
    color: var(--biel);
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: background 0.25s;
  }
  button:hover,
  .download:hover {
    background: var(--glina-ciemna);
  }

  .error {
    color: var(--glina-ciemna);
    font-size: 0.9rem;
    margin-top: 1.2rem;
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .gallery-head h1 {
    margin-bottom: 0.15em;
  }

  /* Under the header rather than in the footer: it is the reason to press the
     download button, and it should be read before the photographs rather than
     after them. */
  .until {
    margin: -0.5rem 0 clamp(1.5rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    color: var(--tekst-jasny);
  }

  .hint {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--tekst-jasny);
  }

  .contact {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--tekst-jasny);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
