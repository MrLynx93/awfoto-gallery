---
/**
 * One screen, nothing else on it.
 *
 * Two steps rather than one: the form creates the gallery, and only then does
 * the drop zone appear — with the link and password already visible above it.
 * That ordering is deliberate. The share link exists the moment she names the
 * client, so if anything goes wrong mid-upload the gallery is still there to
 * resume into, and she is never left having transferred 6 GB with nothing to
 * show for it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import UploadPanel from '../../components/UploadPanel.tsx';
import { create } from '../../../server/galleries.js';
import { generatePassword } from '../../../server/passwords.js';
import { baseUrl } from '../../../server/config.js';
import { ADMIN_COOKIE, isAdmin } from '../../../server/sessions.js';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const EXPIRY_CHOICES = [
  { days: 14, label: '14 dni' },
  { days: 30, label: '30 dni' },
  { days: 60, label: '60 dni' },
  { days: 90, label: '90 dni' },
];

let created = null;
let error = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const clientName = String(form.get('clientName') || '').trim();
  const shootDate = String(form.get('shootDate') || '').trim();
  const expiryDays = Number(form.get('expiryDays') || 30);

  if (!clientName) {
    error = 'Wpisz imię klienta — będzie widoczne na stronie ze zdjęciami.';
  } else {
    const password = generatePassword();
    const { slug } = await create({ clientName, shootDate, password, expiryDays });
    created = { slug, password, shareUrl: `${baseUrl}/g/${slug}` };
  }
}

const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={created ? 'Wyślij zdjęcia' : 'Nowa galeria'} wide={Boolean(created)}>
  {
    created ? (
      <>
        <h1>Wyślij zdjęcia</h1>
        <UploadPanel
          client:load
          slug={created.slug}
          password={created.password}
          shareUrl={created.shareUrl}
        />
      </>
    ) : (
      <section class="form-screen">
        <h1>Nowa galeria</h1>
        <p class="lead">Najpierw krótko o sesji. Zdjęcia wybierzesz na następnym ekranie.</p>

        <form method="POST">
          <label>
            <span>Imię klienta</span>
            <input
              name="clientName"
              type="text"
              required
              autofocus
              placeholder="Zuzia i Marek"
            />
          </label>

          <label>
            <span>Data sesji</span>
            <input name="shootDate" type="date" value={today} />
          </label>

          <label>
            <span>Galeria zniknie po</span>
            <select name="expiryDays">
              {EXPIRY_CHOICES.map((choice) => (
                <option value={choice.days} selected={choice.days === 30}>
                  {choice.label}
                </option>
              ))}
            </select>
          </label>

          <button type="submit">Dalej</button>
        </form>

        {error && <p class="error" role="alert">{error}</p>}

        <p class="note">
          Zdjęcia kasują się same po upływie tego czasu, żeby na serwerze było
          miejsce na kolejne sesje.
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .form-screen { max-width: 30rem; margin: clamp(1rem, 6vh, 4rem) auto; }
  .lead { color: var(--tekst-jasny); margin-bottom: 2rem; }

  form { display: flex; flex-direction: column; gap: 1.4rem; }
  label { display: flex; flex-direction: column; gap: 0.45rem; }
  label span {
    font-size: 0.72rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--tekst-jasny);
  }
  input, select {
    font-family: var(--body); font-size: 1.05rem; padding: 0.7em 0.8em;
    border: 1px solid var(--taupe); border-radius: 3px;
    background: var(--biel); color: var(--tekst);
  }
  input:focus-visible, select:focus-visible {
    outline: 2px solid var(--glina); outline-offset: 2px; border-color: transparent;
  }
  button {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
    margin-top: 0.6rem; transition: background 0.25s;
  }
  button:hover { background: var(--glina-ciemna); }
  .error { color: var(--glina-ciemna); margin-top: 1.2rem; }
  .note { margin-top: 2rem; font-size: 0.85rem; color: var(--tekst-jasny); }
</style>

<style is:global>
  /* The finish line. She has just spent an hour on this screen; the link and
     the password are the only things that matter at the end of it, so they get
     the weight rather than the drop zone that is now empty. */
  .panel { display: flex; flex-direction: column; gap: 2rem; }

  .finish {
    background: var(--bez); border: 1px solid var(--piaskowy);
    border-radius: 4px; padding: clamp(1.5rem, 4vw, 2.2rem);
  }
  .finish-label {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tekst-jasny); margin: 0 0 0.3rem;
  }
  .finish-link {
    font-size: 1.05rem; margin: 0 0 1.4rem; word-break: break-all;
    color: var(--tekst);
  }
  .finish-password {
    font-family: var(--body); font-size: 2rem; letter-spacing: 0.3em;
    margin: 0 0 1.6rem; color: var(--glina-ciemna);
  }
  .finish-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .finish-actions button {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
    transition: background 0.25s;
  }
  .finish-actions button:hover { background: var(--glina-ciemna); }
  .finish-actions .ghost {
    background: transparent; color: var(--glina-ciemna);
    border: 1px solid var(--taupe);
  }
  .finish-actions .ghost:hover { background: var(--piaskowy); color: var(--tekst); }
  .finish-note { margin: 1.4rem 0 0; font-size: 0.85rem; color: var(--tekst-jasny); }

  .status { color: var(--tekst-jasny); font-size: 0.9rem; margin: 0; }
  .errors {
    background: #f7ece6; border: 1px solid var(--taupe);
    border-radius: 4px; padding: 1.2rem;
  }
  .errors p { margin: 0 0 1rem; }
  .errors button {
    font-family: var(--body); font-size: 0.78rem; letter-spacing: 0.12em;
    text-transform: uppercase; padding: 0.8em 1.4em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
  }
  .hint { font-size: 0.85rem; color: var(--tekst-jasny); margin: 0; }
</style>
