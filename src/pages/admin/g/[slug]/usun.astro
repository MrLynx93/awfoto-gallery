---
/**
 * "Are you sure?" — and it has to be asked properly.
 *
 * Deleting a gallery destroys the originals. If she has already cleared the
 * card, there is nothing anywhere to restore from, so this is the one action in
 * the panel that cannot be undone by any means at all. That is worth a screen
 * rather than a `confirm()` box: this one names the client, counts the photos
 * and says plainly what will be gone, so the decision is made looking at the
 * gallery rather than at a dialog that says "OK / Cancel".
 *
 * It is also a plain form, so it works with no JavaScript, and a POST rather
 * than a link, so nothing deletes a wedding by being prefetched or crawled.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DeleteGalleryConfirm from '../../../../components/DeleteGalleryConfirm.astro';
import { findBySlug } from '../../../../../server/galleries.js';
import { removeGallery } from '../../../../../server/removal.js';
import { galleryAdminPath } from '../../../../../server/paths.js';
import { ADMIN_COOKIE, isAdmin } from '../../../../../server/sessions.js';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const gallery = await findBySlug(slug);

// Already gone -- a second submit, or the nightly sweep got there first. The
// list is the honest answer either way, and it is where a successful delete
// lands too, so the two are indistinguishable to her. They should be.
if (!gallery) {
  return Astro.redirect('/admin');
}

if (Astro.request.method === 'POST') {
  await removeGallery(gallery);
  // Post/Redirect/Get: a refresh must not re-run a delete, and the banner is
  // carried in the URL rather than a cookie because it survives exactly one
  // page and nothing else needs to know about it.
  return Astro.redirect('/admin?usunieto=1', 303);
}

// Reached from the gallery rather than from the list -- the no-JavaScript path
// of its "Usuń galerię" button. "No" should then put her back where she was.
const fromGallery = Astro.url.searchParams.get('wroc') === 'galeria';
const cancel = fromGallery
  ? { href: galleryAdminPath(slug), label: 'Nie, wróć do galerii' }
  : { href: '/admin', label: 'Nie, wróć do listy' };
---

<BaseLayout
  title="Usuń galerię"
  crumbs={[
    { label: 'Galeria', href: '/admin' },
    { label: gallery.clientName, href: galleryAdminPath(slug) },
    { label: 'Usuń' },
  ]}
>
  <section class="confirm">
    <h1>Usunąć tę galerię?</h1>

    <DeleteGalleryConfirm gallery={gallery} cancel={cancel} />

    <p class="note">
      Chcesz tylko przedłużyć termin albo poprawić dane? <a
        href={galleryAdminPath(slug)}>Wróć do galerii</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .confirm { max-width: 34rem; margin: clamp(1rem, 6vh, 4rem) auto; }
  h1 { margin-bottom: 1.6rem; }
  .note { margin-top: 2.5rem; font-size: 0.85rem; color: var(--tekst-jasny); }
</style>
