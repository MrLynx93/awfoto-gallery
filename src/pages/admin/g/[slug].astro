---
/**
 * The photographer's page for one gallery. There is only one.
 *
 * It used to be two: a view at this URL and an editor at /admin/galeria/<slug>,
 * with a button on each pointing at the other. Nothing was gained by the split
 * -- she is the only person who ever opens either, she is always allowed to
 * change what she is looking at, and "which of the two am I on?" was a question
 * the panel had no business asking. So the details, the link, the drop zone and
 * the photos are one page now, and the edit button is gone because there is
 * nothing to switch into.
 *
 * The order is what she does with it: what the session is, what to send the
 * client, where to drop more photos, and then the photos themselves. Everything
 * she came for is above the grid, so a wedding's worth of thumbnails is never
 * in the way.
 *
 * The password is simply here, every time -- stored sealed alongside the scrypt
 * hash (server/passwords.js) so this page can show it rather than offering a
 * new one. No gate in front of any of it: `server/routes/files.js` honours the
 * admin session for the previews, the originals and the ZIP, and /g/<slug>
 * stays exactly what the client gets, gate and all.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryEditor from '../../../components/GalleryEditor.tsx';
import DeleteGalleryConfirm from '../../../components/DeleteGalleryConfirm.astro';
import GalleryGrid from '../../../components/GalleryGrid.astro';
import PhotoUploader from '../../../components/PhotoUploader.tsx';
import Lightbox from '../../../components/Lightbox.astro';
import { readManifest, progress } from '../../../../server/storage.js';
import {
  findBySlug,
  markPhotosChanged,
  setPassword,
  readPassword,
} from '../../../../server/galleries.js';
import { removePhoto } from '../../../../server/photos.js';
import { removeGallery } from '../../../../server/removal.js';
import { wakeWorker } from '../../../../server/wake.js';
import { describeGallery } from '../../../../server/gallery-view.js';
import { EXPIRY_CHOICES, DEFAULT_EXPIRY_DAYS } from '../../../../server/gallery-form.js';
import { photoCount } from '../../../../server/format.js';
import { generatePassword } from '../../../../server/passwords.js';
import { galleryAdminPath, galleryDeletePath, galleryProgressPath } from '../../../../server/paths.js';
import { ADMIN_COOKIE, isAdmin } from '../../../../server/sessions.js';
import '../../../styles/editor.css';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const row = await findBySlug(slug);

// A slug that is not there means a stale bookmark or a gallery the nightly
// sweep has taken, and the list of what does exist answers both.
if (!row) {
  return Astro.redirect('/admin');
}

/**
 * The three form posts this page answers. Both are forms rather than fetches so
 * they work if the island never hydrates, and both end in a redirect so a
 * refresh does not repeat them -- minting a third password after she copied the
 * second, or deleting a photo she has already deleted.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'delete-gallery') {
    await removeGallery(row);
    // The gallery this page is about no longer exists, so the list is the only
    // place left to land -- and it says what happened.
    return Astro.redirect('/admin?usunieto=1', 303);
  }

  if (intent === 'delete-photo') {
    const removed = await removePhoto(slug, String(form.get('id') ?? ''));

    if (removed) {
      // The archive still holds the deleted photo, so the gallery goes back to
      // preparing and the worker rebuilds it. Every other photo's previews are
      // untouched -- they are named for the photograph, not for where it sat --
      // so that run is a ZIP and nothing more.
      await markPhotosChanged(slug, removed.remaining);
      wakeWorker('photos');
    }

    // Same URL either way: an id this gallery no longer has means a double
    // submit or a stale page, and the grid she lands on is the answer.
    return Astro.redirect(`${galleryAdminPath(slug)}${removed ? '?zdjecie=usuniete' : ''}`, 303);
  }

  await setPassword(slug, generatePassword());
  return Astro.redirect(galleryAdminPath(slug), 303);
}

const gallery = describeGallery(row);
const password = readPassword(row);
const justRemoved = Astro.url.searchParams.has('zdjecie');

/**
 * What the client is seeing right now, in her words rather than the row's.
 * `working` is handled separately, below -- it is the one state this page
 * expects her to come back to, so it gets a progress bar and a live-updating
 * script rather than a plain sentence.
 */
const STATUS_NOTE: Record<string, string> = {
  ready: 'Galeria jest gotowa — klient widzi zdjęcia i może pobrać wszystkie naraz.',
  failed: 'Coś się nie udało przy przygotowaniu zdjęć. Wyślij je jeszcze raz.',
  zip_unavailable:
    'Galeria jest gotowa. Paczka ZIP powstanie dopiero przy pobieraniu, bo na serwerze jest mało miejsca.',
};

/**
 * Not trusting `gallery.status` alone, because the row only ever says
 * 'preparing' for a gallery's first batch or right after a delete
 * (`markPhotosChanged`) -- dropping a few more photos into a gallery that
 * already finished leaves the row saying 'ready' for the entire time the
 * worker is quietly catching up on them.
 *
 * `gallery.photoCount < total`, not `done < total`, is what actually catches
 * that case, and the difference is not cosmetic. `photoCount` is written
 * once, by `markReady()`, at the very end of a run -- after the worker has
 * gone quiet for 45s (`QUIET_PERIOD_MS`, in case more files are still
 * arriving), rebuilt the archive and rewritten the manifest. `done` (the
 * previews already on disk) reaches `total` well before any of that: every
 * photo can have its derivatives finished while the worker is still idling
 * out that quiet window. Reloading the moment `done` catches up would show a
 * manifest and a photo count that do not have the new photos in them yet --
 * confirmed by watching it happen. `photoCount` only moves when the row
 * actually has the new total, which is the one moment a reload is safe.
 *
 * `status === 'preparing'` still covers a brand-new gallery with nothing on
 * disk yet to count, and `failed` is excluded because a hard failure leaves
 * `photoCount` at 0 permanently, with no worker run going to change that on
 * its own. The admin API route (postep.ts) applies the identical rule, since
 * the live poll below has to agree with this first paint or the banner would
 * flicker the moment it loads.
 */
const uploadProgress = await progress(slug);
const working =
  gallery.status === 'preparing' ||
  (gallery.status !== 'failed' && gallery.photoCount < uploadProgress.total);
const hasProgress = uploadProgress.total > 0;
const progressPct = hasProgress
  ? Math.round((uploadProgress.done / uploadProgress.total) * 100)
  : 0;

let photos = [];
try {
  photos = (await readManifest(slug)).photos ?? [];
} catch {
  // No manifest yet: the worker has not finished, or nothing has been uploaded.
  // The editor's own note says which; this page just has no grid to draw.
}
---

<BaseLayout
  title={gallery.sessionName}
  width="panel"
  crumbs={[{ label: 'Galeria', href: '/admin' }, { label: gallery.sessionName }]}
>
  <GalleryEditor
    client:load
    gallery={gallery}
    password={password}
    expiryChoices={EXPIRY_CHOICES}
    defaultExpiryDays={DEFAULT_EXPIRY_DAYS}
    deletePath={`${galleryDeletePath(slug)}?wroc=galeria`}
  />

  {/* The question, asked without leaving the gallery. The button in the header
      above opens it; with no JavaScript that button is simply a link to the
      page version, which asks exactly the same thing. Escape and the backdrop
      close it, and "no" is a plain formmethod="dialog" submit -- no script of
      its own anywhere in here. */}
  <DeleteGalleryConfirm
    gallery={row}
    dialogId="usun-dialog"
    cancel={{ label: 'Nie, zostaw' }}
  />

  {/* A card like the details above it, so the page reads as three panels
      rather than two and a loose grid. No "pobierz wszystkie" here: this is her
      screen, the ZIP is what the client's page offers, and she has the
      originals on the card they came from. */}
  <section class="card photos">
    <h2 class="card-title">
      {photos.length > 0 ? photoCount(photos.length) : 'Zdjęcia'}
    </h2>

    {/* What the client is seeing right now, next to the photos it is about --
        rather than tucked under the link, which is not what it describes.
        `preparing` used to be two boxes stacked here: this note, and, right
        after a delete, a second one repeating the same fact in different
        words. One box now covers both, because they were never two things --
        removing a photo just puts the gallery back into this same status, so
        there is one thing happening and it deserves one thing said about it.

        Both this and the plain .state line below are always in the markup,
        toggled with `hidden` rather than one being conditionally rendered --
        the script further down flips between them the moment an upload
        finishes, and it can only do that by hiding and revealing real
        elements, not by asking Astro to build one from scratch. Without
        JavaScript neither one moves and the server-rendered state is simply
        correct for whenever the page happened to load. */}
    <p class="preparing" role="status" id="preparing-banner" hidden={!working}>
      <svg class="warning-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.6 21.4 20H2.6L12 3.6Z" />
        <path d="M12 9.6v4.4" />
        <circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none" />
      </svg>
      <span class="preparing-body">
        <span class="preparing-text" id="preparing-text">
          {justRemoved
            ? 'Zdjęcie zostało usunięte, więc paczka do pobrania przygotowuje się od nowa. Klient na razie widzi informację, że galeria się szykuje.'
            : 'Przygotowuję zdjęcia — klient na razie widzi informację, że galeria się szykuje.'}
          {' '}Ta strona zaktualizuje się sama, gdy będzie gotowa — bez JavaScriptu odśwież ją ręcznie, żeby sprawdzić.
        </span>
        {/* A div-based bar rather than <progress>: the width, the stripe that
            slides across it and the count beside it all need to animate
            smoothly on every poll, which a native <progress> element does
            not reliably do across browsers. `hidden` rather than leaving it
            out entirely, same reasoning as the two states above -- the
            upload-triggered script needs a real element to reveal once the
            first live number arrives. */}
        <span class="preparing-meter" id="preparing-meter" hidden={!hasProgress}>
          <span
            class="preparing-track"
            id="preparing-track"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={progressPct}
          >
            <span class="preparing-fill" id="preparing-fill" style={`width: ${progressPct}%`} />
          </span>
          <span class="preparing-count" id="preparing-count">
            {uploadProgress.done} z {uploadProgress.total} zdjęć ({progressPct}%)
          </span>
        </span>
      </span>
    </p>
    <p class="state" id="gallery-state" hidden={working}>
      {STATUS_NOTE[gallery.status] ?? 'Link działa od razu.'}
    </p>

    {/* Polls postep.ts every couple of seconds while `working`, so the bar
        moves and the count climbs without a reload -- and reloads exactly
        once, the moment the answer says there is nothing left to do, which is
        the one point a reload actually earns its keep: revealing the
        finished grid. `zdjecia-wyslane`, dispatched by PhotoUploader.tsx the
        moment one file finishes uploading, is what makes the banner appear
        immediately after a drop into an already-`ready` gallery, rather than
        waiting for her to notice on a later visit -- that gallery's own row
        still says 'ready' the entire time the worker is quietly catching up
        on the new files, so nothing server-rendered would show it otherwise.
        Progressive enhancement only: without JavaScript this never runs, and
        the sentence above already told her to reload by hand instead. */}
    <script
      is:inline
      data-progress-url={galleryProgressPath(row.slug)}
      data-initially-working={working ? '1' : ''}
      data-initial-done={uploadProgress.done}
      data-initial-total={uploadProgress.total}
    >
      (function (scriptEl) {
          if (!scriptEl) return;
          const banner = document.getElementById('preparing-banner');
          const stateEl = document.getElementById('gallery-state');
          const textEl = document.getElementById('preparing-text');
          const meterEl = document.getElementById('preparing-meter');
          const trackEl = document.getElementById('preparing-track');
          const fillEl = document.getElementById('preparing-fill');
          const countEl = document.getElementById('preparing-count');
          if (!banner || !stateEl || !meterEl) return;

          const progressUrl = scriptEl.dataset.progressUrl;
          let shownDone = Number(scriptEl.dataset.initialDone) || 0;
          let shownTotal = Number(scriptEl.dataset.initialTotal) || 0;
          let polling = false;
          let timer = null;
          let raf = null;

          // Counts the visible number up (or down) to a new value over a
          // short span instead of jumping, so three photos finishing between
          // polls reads as progress rather than a number changing twice.
          function animateCount(from, to, totalNow, duration) {
            if (raf) cancelAnimationFrame(raf);
            const start = performance.now();
            const step = (now) => {
              const t = Math.min(1, (now - start) / duration);
              const value = Math.round(from + (to - from) * t);
              const pct = totalNow > 0 ? Math.round((value / totalNow) * 100) : 0;
              countEl.textContent = value + ' z ' + totalNow + ' zdjęć (' + pct + '%)';
              if (t < 1) {
                raf = requestAnimationFrame(step);
              } else {
                raf = null;
              }
            };
            raf = requestAnimationFrame(step);
          }

          function applyProgress(done, total) {
            if (total <= 0) {
              meterEl.hidden = true;
              shownDone = done;
              shownTotal = total;
              return;
            }
            meterEl.hidden = false;
            const pct = Math.round((done / total) * 100);
            fillEl.style.width = pct + '%';
            trackEl.setAttribute('aria-valuenow', String(pct));
            if (done !== shownDone || total !== shownTotal) {
              animateCount(shownDone, done, total, 500);
            }
            shownDone = done;
            shownTotal = total;
          }

          function show() {
            banner.hidden = false;
            stateEl.hidden = true;
          }

          function poll() {
            fetch(progressUrl, { headers: { accept: 'application/json' } })
              .then((r) => (r.ok ? r.json() : null))
              .then((data) => {
                if (!data) throw new Error('bad response');
                if (data.working) {
                  show();
                  applyProgress(data.done, data.total);
                  timer = setTimeout(poll, 2000);
                } else {
                  // The one reload this still does: the grid itself, the
                  // photo count heading and everything else on the page
                  // needs the new photos, and rebuilding all of that here
                  // would be a second copy of what the server already does
                  // on every load.
                  location.reload();
                }
              })
              .catch(() => {
                // A dropped request just tries again rather than freezing the
                // bar or reloading on a guess.
                timer = setTimeout(poll, 2000);
              });
          }

          function start() {
            if (polling) return;
            polling = true;
            show();
            if (timer) clearTimeout(timer);
            poll();
          }

          if (scriptEl.dataset.initiallyWorking) start();
          window.addEventListener('zdjecia-wyslane', start);
        })(document.currentScript);
    </script>

    <GalleryGrid slug={row.slug} photos={photos} deletable={true}>
      {/* The drop zone, shaped like the photographs it sits among. Astro wraps
          an island in <astro-island>, which `display: contents` keeps out of the
          grid's way so the uploader itself is the cell. */}
      <PhotoUploader client:load slug={row.slug} variant="card" slot="lead" />
    </GalleryGrid>
    {/* Where PhotoUploader portals "Wysłano N zdjęć" and any failure list --
        the card above it is sized like the photographs beside it, with no room
        for either. Always present, even before a first upload, since the
        portal target has to exist before the island can find it. */}
    <div id="uploader-feedback"></div>
    {photos.length > 0 && <Lightbox />}
  </section>
</BaseLayout>

<style>
  /* The gap the editor's own sections have between them: this one is a sibling
     of the cards above rather than a child of the island that draws them. */
  .photos { margin-top: 2rem; }

  /* Amber rather than the destructive red of the delete warning below --
     nothing has gone wrong here, something is just not finished yet.

     `:not([hidden])` rather than a bare `.preparing`: a class selector and
     the browser's own `[hidden] { display: none }` rule have equal
     specificity, and an author rule wins that tie regardless of which one
     is more specific in spirit -- so a bare `display: flex` here would
     silently override `hidden` and show this banner always. Confirmed by
     testing the toggle, not assumed: the previous version got away with it
     only because the two states were never both in the DOM at once. */
  .preparing:not([hidden]) {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: #f6e9c9;
    border: 1px solid #ddc07f;
    border-radius: 4px;
    padding: 0.9rem 1.2rem;
    margin: 0 0 1.2rem;
    color: #7c5e22;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .warning-icon {
    flex: none;
    margin-top: 0.15rem;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .preparing-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* The icon is aligned to the first line of text above; without a
       min-width the bar and count below it would be free to shrink the
       whole box down to their own (much narrower) content. */
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Same reasoning as .preparing above -- this is also toggled with
     `hidden` from script, on the initial paint and by applyProgress(). */
  .preparing-meter:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  /* The bar is the point; the count beside it is what makes a number like
     "612 z 800" mean something faster than counting the fill by eye.

     A plain div rather than <progress>: the width needs to transition
     smoothly on every poll and carry a moving stripe on top of that, and a
     native <progress> element's fill is a replaced element whose pseudo-
     elements do not reliably animate the same way across browsers. A real
     `width` on a real box does, everywhere. */
  .preparing-track {
    flex: 1 1 auto;
    min-width: 0;
    height: 0.5rem;
    border-radius: 999px;
    background: rgba(124, 94, 34, 0.18);
    overflow: hidden;
  }
  .preparing-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background-color: #7c5e22;
    /* The moving stripe is what says "still going" independently of the
       count -- the same reason the old spinner existed, kept here as a
       texture on top of a bar that now also says how far. */
    background-image: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.3) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.3) 75%,
      transparent 75%,
      transparent
    );
    background-size: 1rem 1rem;
    animation: preparing-stripes 0.9s linear infinite;
    transition: width 0.5s ease;
  }
  @keyframes preparing-stripes {
    from { background-position: 0 0; }
    to { background-position: 1rem 0; }
  }
  /* An animation with no natural end is exactly the kind worth slowing
     rather than stopping outright -- a frozen diagonal stripe reads as
     broken, not as respecting the preference. */
  @media (prefers-reduced-motion: reduce) {
    .preparing-fill { animation-duration: 3s; }
  }
  .preparing-count {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    white-space: nowrap;
  }
</style>
