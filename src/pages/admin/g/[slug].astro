---
/**
 * The photographer's page for one gallery. There is only one.
 *
 * It used to be two: a view at this URL and an editor at /admin/galeria/<slug>,
 * with a button on each pointing at the other. Nothing was gained by the split
 * -- she is the only person who ever opens either, she is always allowed to
 * change what she is looking at, and "which of the two am I on?" was a question
 * the panel had no business asking. So the details, the link, the drop zone and
 * the photos are one page now, and the edit button is gone because there is
 * nothing to switch into.
 *
 * The order is what she does with it: what the session is, what to send the
 * client, where to drop more photos, and then the photos themselves. Everything
 * she came for is above the grid, so a wedding's worth of thumbnails is never
 * in the way.
 *
 * The password is simply here, every time -- stored sealed alongside the scrypt
 * hash (server/passwords.js) so this page can show it rather than offering a
 * new one. No gate in front of any of it: `server/routes/files.js` honours the
 * admin session for the previews, the originals and the ZIP, and /g/<slug>
 * stays exactly what the client gets, gate and all.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryEditor from '../../../components/GalleryEditor.tsx';
import DeleteGalleryConfirm from '../../../components/DeleteGalleryConfirm.astro';
import GalleryGrid from '../../../components/GalleryGrid.astro';
import PreparingBanner from '../../../components/PreparingBanner.astro';
import PhotoUploader from '../../../components/PhotoUploader.tsx';
import Lightbox from '../../../components/Lightbox.astro';
import { readManifest, progress } from '../../../../server/storage.js';
import {
  findBySlug,
  markPhotosChanged,
  setPassword,
  readPassword,
} from '../../../../server/galleries.js';
import { removePhoto } from '../../../../server/photos.js';
import { removeGallery } from '../../../../server/removal.js';
import { wakeWorker } from '../../../../server/wake.js';
import { describeGallery } from '../../../../server/gallery-view.js';
import { EXPIRY_CHOICES, DEFAULT_EXPIRY_DAYS } from '../../../../server/gallery-form.js';
import { photoCount } from '../../../../server/format.js';
import { generatePassword } from '../../../../server/passwords.js';
import { galleryAdminPath, galleryDeletePath } from '../../../../server/paths.js';
import { ADMIN_COOKIE, isAdmin } from '../../../../server/sessions.js';
import '../../../styles/editor.css';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const row = await findBySlug(slug);

// A slug that is not there means a stale bookmark or a gallery the nightly
// sweep has taken, and the list of what does exist answers both.
if (!row) {
  return Astro.redirect('/admin');
}

/**
 * The three form posts this page answers. Both are forms rather than fetches so
 * they work if the island never hydrates, and both end in a redirect so a
 * refresh does not repeat them -- minting a third password after she copied the
 * second, or deleting a photo she has already deleted.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'delete-gallery') {
    await removeGallery(row);
    // The gallery this page is about no longer exists, so the list is the only
    // place left to land -- and it says what happened.
    return Astro.redirect('/admin?usunieto=1', 303);
  }

  if (intent === 'delete-photo') {
    const removed = await removePhoto(slug, String(form.get('id') ?? ''));

    if (removed) {
      // The archive still holds the deleted photo, so the gallery goes back to
      // preparing and the worker rebuilds it. Every other photo's previews are
      // untouched -- they are named for the photograph, not for where it sat --
      // so that run is a ZIP and nothing more.
      await markPhotosChanged(slug, removed.remaining);
      wakeWorker('photos');
    }

    // Same URL either way: an id this gallery no longer has means a double
    // submit or a stale page, and the grid she lands on is the answer.
    return Astro.redirect(`${galleryAdminPath(slug)}${removed ? '?zdjecie=usuniete' : ''}`, 303);
  }

  await setPassword(slug, generatePassword());
  return Astro.redirect(galleryAdminPath(slug), 303);
}

const gallery = describeGallery(row);
const password = readPassword(row);
const justRemoved = Astro.url.searchParams.has('zdjecie');

/**
 * What the client is seeing right now, in her words rather than the row's.
 * `working` is handled separately, below -- it is the one state this page
 * expects her to come back to, so it gets a progress bar and a live-updating
 * script rather than a plain sentence.
 */
const STATUS_NOTE: Record<string, string> = {
  ready: 'Galeria jest gotowa — klient widzi zdjęcia i może pobrać wszystkie naraz.',
  failed: 'Coś się nie udało przy przygotowaniu zdjęć. Wyślij je jeszcze raz.',
  zip_unavailable:
    'Galeria jest gotowa. Paczka ZIP powstanie dopiero przy pobieraniu, bo na serwerze jest mało miejsca.',
};

/**
 * Not trusting `gallery.status` alone, because the row only ever says
 * 'preparing' for a gallery's first batch or right after a delete
 * (`markPhotosChanged`) -- dropping a few more photos into a gallery that
 * already finished leaves the row saying 'ready' for the entire time the
 * worker is quietly catching up on them.
 *
 * `gallery.photoCount < total`, not `done < total`, is what actually catches
 * that case, and the difference is not cosmetic. `photoCount` is written
 * once, by `markReady()`, at the very end of a run -- after the worker has
 * gone quiet for 45s (`QUIET_PERIOD_MS`, in case more files are still
 * arriving), rebuilt the archive and rewritten the manifest. `done` (the
 * previews already on disk) reaches `total` well before any of that: every
 * photo can have its derivatives finished while the worker is still idling
 * out that quiet window. Reloading the moment `done` catches up would show a
 * manifest and a photo count that do not have the new photos in them yet --
 * confirmed by watching it happen. `photoCount` only moves when the row
 * actually has the new total, which is the one moment a reload is safe.
 *
 * `status === 'preparing'` still covers a brand-new gallery with nothing on
 * disk yet to count, and `failed` is excluded because a hard failure leaves
 * `photoCount` at 0 permanently, with no worker run going to change that on
 * its own. The admin API route (postep.ts) applies the identical rule, since
 * the banner's own poll has to agree with this first paint or it would
 * flicker the moment it loads.
 */
const uploadProgress = await progress(slug);
const working =
  gallery.status === 'preparing' ||
  (gallery.status !== 'failed' && gallery.photoCount < uploadProgress.total);

let photos = [];
try {
  photos = (await readManifest(slug)).photos ?? [];
} catch {
  // No manifest yet: the worker has not finished, or nothing has been uploaded.
  // The editor's own note says which; this page just has no grid to draw.
}
---

<BaseLayout
  title={gallery.sessionName}
  width="panel"
  crumbs={[{ label: 'Galeria', href: '/admin' }, { label: gallery.sessionName }]}
>
  <GalleryEditor
    client:load
    gallery={gallery}
    password={password}
    expiryChoices={EXPIRY_CHOICES}
    defaultExpiryDays={DEFAULT_EXPIRY_DAYS}
    deletePath={`${galleryDeletePath(slug)}?wroc=galeria`}
  />

  {/* The question, asked without leaving the gallery. The button in the header
      above opens it; with no JavaScript that button is simply a link to the
      page version, which asks exactly the same thing. Escape and the backdrop
      close it, and "no" is a plain formmethod="dialog" submit -- no script of
      its own anywhere in here. */}
  <DeleteGalleryConfirm
    gallery={row}
    dialogId="usun-dialog"
    cancel={{ label: 'Nie, zostaw' }}
  />

  {/* A card like the details above it, so the page reads as three panels
      rather than two and a loose grid. No "pobierz wszystkie" here: this is her
      screen, the ZIP is what the client's page offers, and she has the
      originals on the card they came from. */}
  <section class="card photos">
    <h2 class="card-title">
      {photos.length > 0 ? photoCount(photos.length) : 'Zdjęcia'}
    </h2>

    {/* What the client is seeing right now, next to the photos it is about --
        rather than tucked under the link, which is not what it describes. One
        box covers both "still preparing" and "ready, link works": removing a
        photo just puts the gallery back into the first, so there is one thing
        happening and it deserves one thing said about it. The same banner is
        on the new-gallery screen, which is why it is a component -- see
        PreparingBanner.astro, which also owns the poll that moves the bar. */}
    <PreparingBanner
      slug={row.slug}
      working={working}
      done={uploadProgress.done}
      total={uploadProgress.total}
      note={STATUS_NOTE[gallery.status] ?? 'Link działa od razu.'}
      text={
        justRemoved
          ? 'Zdjęcie zostało usunięte, więc paczka do pobrania przygotowuje się od nowa. Klient na razie widzi informację, że galeria się szykuje.'
          : 'Przygotowuję zdjęcia — klient na razie widzi informację, że galeria się szykuje.'
      }
    />

    <GalleryGrid slug={row.slug} photos={photos} deletable={true}>
      {/* The drop zone, shaped like the photographs it sits among. Astro wraps
          an island in <astro-island>, which `display: contents` keeps out of the
          grid's way so the uploader itself is the cell. */}
      <PhotoUploader client:load slug={row.slug} variant="card" slot="lead" />
    </GalleryGrid>
    {/* Where PhotoUploader portals "Wysłano N zdjęć" and any failure list --
        the card above it is sized like the photographs beside it, with no room
        for either. Always present, even before a first upload, since the
        portal target has to exist before the island can find it. */}
    <div id="uploader-feedback"></div>
    {photos.length > 0 && <Lightbox />}
  </section>
</BaseLayout>

<style>
  /* The gap the editor's own sections have between them: this one is a sibling
     of the cards above rather than a child of the island that draws them. */
  .photos { margin-top: 2rem; }
</style>
