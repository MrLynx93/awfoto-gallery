---
/**
 * Step two of two: the drop zone, with the link and password above it.
 *
 * A plain GET, so it survives a refresh, a bookmark and a re-open the next
 * morning -- which matters, because an interrupted upload is resumed by coming
 * back to this exact URL and dragging the same folder in again.
 *
 * The password is the awkward part. Only its scrypt hash is stored, so it
 * cannot be recovered here; it arrives in a signed, httpOnly cookie set by the
 * page that created the gallery. When that cookie is gone -- another browser, a
 * few days later -- the screen still works, and offers a new password instead
 * of pretending the old one can be dug out.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import UploadPanel from '../../../components/UploadPanel.tsx';
import { findBySlug, setPassword, isExpired } from '../../../../server/galleries.js';
import { generatePassword } from '../../../../server/passwords.js';
import { baseUrl } from '../../../../server/config.js';
import {
  ADMIN_COOKIE,
  isAdmin,
  cookieOptions,
  issueNewGalleryPassword,
  readNewGalleryPassword,
  newGalleryCookieName,
  newGalleryCookiePath,
  GALLERY_TTL,
} from '../../../../server/sessions.js';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const gallery = await findBySlug(slug);

// Back to the dashboard rather than an error page: from here, a slug that does
// not exist means a stale bookmark or a gallery the nightly sweep has taken,
// and the list of what *does* exist is the useful answer to both.
if (!gallery) {
  return Astro.redirect('/admin');
}

// Post/Redirect/Get again: setting a new password must not be repeatable by
// refreshing, or she would end up with a password different from the one she
// just copied.
if (Astro.request.method === 'POST') {
  const password = generatePassword();
  await setPassword(slug, password);
  Astro.cookies.set(
    newGalleryCookieName(slug),
    issueNewGalleryPassword(slug, password),
    cookieOptions(GALLERY_TTL, newGalleryCookiePath(slug)),
  );
  return Astro.redirect(newGalleryCookiePath(slug), 303);
}

const password = readNewGalleryPassword(
  Astro.cookies.get(newGalleryCookieName(slug))?.value,
  slug,
);

const shareUrl = `${baseUrl}/g/${slug}`;
const expired = isExpired(gallery);
---

<BaseLayout title="Wyślij zdjęcia" wide={true}>
  <header class="head">
    <h1>Wyślij zdjęcia</h1>
    <p class="who">
      {gallery.clientName}{gallery.shootDate ? ` · ${gallery.shootDate}` : ''}
    </p>
  </header>

  {
    expired && (
      <p class="warn" role="alert">
        Termin tej galerii już minął — klient jej nie otworzy. Załóż nową
        galerię dla tej sesji.
      </p>
    )
  }

  <UploadPanel client:load slug={slug} password={password} shareUrl={shareUrl} />
</BaseLayout>

<style>
  .head { margin-bottom: 2rem; }
  .head h1 { margin: 0 0 0.3rem; }
  .who { margin: 0; color: var(--tekst-jasny); font-size: 0.95rem; }
  .warn {
    background: #f7ece6; border: 1px solid var(--taupe); border-radius: 4px;
    padding: 1rem 1.2rem; margin-bottom: 2rem; color: var(--glina-ciemna);
  }
</style>

<style is:global>
  /* The finish line. She has just spent an hour on this screen; the link and
     the password are the only things that matter at the end of it, so they get
     the weight rather than the drop zone that is now empty. */
  .panel { display: flex; flex-direction: column; gap: 2rem; }

  .finish {
    background: var(--bez); border: 1px solid var(--piaskowy);
    border-radius: 4px; padding: clamp(1.5rem, 4vw, 2.2rem);
  }
  .finish-label {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tekst-jasny); margin: 0 0 0.3rem;
  }
  .finish-link {
    font-size: 1.05rem; margin: 0 0 1.4rem; word-break: break-all;
    color: var(--tekst);
  }
  .finish-password {
    font-family: var(--body); font-size: 2rem; letter-spacing: 0.3em;
    margin: 0 0 1.6rem; color: var(--glina-ciemna);
  }
  .finish-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .finish-actions button {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
    transition: background 0.25s;
  }
  .finish-actions button:hover { background: var(--glina-ciemna); }
  .finish-actions .ghost {
    background: transparent; color: var(--glina-ciemna);
    border: 1px solid var(--taupe);
  }
  .finish-actions .ghost:hover { background: var(--piaskowy); color: var(--tekst); }
  .finish-note { margin: 1.4rem 0 0; font-size: 0.85rem; color: var(--tekst-jasny); }

  /* Shown only when the password could not be carried here. It is a form, not
     a button with JavaScript behind it, so it works even if the island never
     hydrates. */
  .repass { margin: 0 0 1.4rem; }
  .repass p { margin: 0 0 0.9rem; font-size: 0.9rem; color: var(--tekst-jasny); }
  .repass button {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
    transition: background 0.25s;
  }
  .repass button:hover { background: var(--glina-ciemna); }

  .status { color: var(--tekst-jasny); font-size: 0.9rem; margin: 0; }
  .errors {
    background: #f7ece6; border: 1px solid var(--taupe);
    border-radius: 4px; padding: 1.2rem;
  }
  .errors p { margin: 0 0 1rem; }
  .errors button {
    font-family: var(--body); font-size: 0.78rem; letter-spacing: 0.12em;
    text-transform: uppercase; padding: 0.8em 1.4em; border: 0; border-radius: 3px;
    background: var(--glina); color: var(--biel); cursor: pointer;
  }
  .hint { font-size: 0.85rem; color: var(--tekst-jasny); margin: 0; }
</style>
