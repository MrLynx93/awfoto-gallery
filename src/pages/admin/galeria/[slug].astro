---
/**
 * An existing gallery, on the same screen that created it.
 *
 * Reached from the dashboard's "Edytuj" link, and also by the editor itself:
 * after it creates a gallery it rewrites the address bar to this URL, so a
 * refresh mid-upload lands here. That is the resume path -- come back to this
 * page, drag the same folder in, and Uppy's fingerprints continue the transfer
 * where it stopped rather than starting it again.
 *
 * The password is simply here, every time. It is stored sealed alongside the
 * scrypt hash (server/passwords.js) precisely so this screen can show it again
 * -- she should never have to tell a client that last week's code is dead
 * because she reopened the panel. Galleries created before that column existed
 * have nothing to show, and those still offer a new password instead.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryEditor from '../../../components/GalleryEditor.tsx';
import { findBySlug, setPassword, readPassword } from '../../../../server/galleries.js';
import { describeGallery } from '../../../../server/gallery-view.js';
import { EXPIRY_CHOICES, DEFAULT_EXPIRY_DAYS } from '../../../../server/gallery-form.js';
import { generatePassword } from '../../../../server/passwords.js';
import { galleryEditPath } from '../../../../server/paths.js';
import { ADMIN_COOKIE, isAdmin } from '../../../../server/sessions.js';
import '../../../styles/editor.css';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const row = await findBySlug(slug);

// Back to the dashboard rather than an error page: from here, a slug that does
// not exist means a stale bookmark or a gallery the nightly sweep has taken,
// and the list of what *does* exist is the useful answer to both.
if (!row) {
  return Astro.redirect('/admin');
}

// Issuing a new password is still a form POST rather than a fetch: it has to
// keep working if the island never hydrates. Post/Redirect/Get, so refreshing
// does not mint a third password after she has copied the second -- the page it
// redirects to reads the new one straight out of the row.
if (Astro.request.method === 'POST') {
  await setPassword(slug, generatePassword());
  return Astro.redirect(galleryEditPath(slug), 303);
}

const gallery = describeGallery(row);

// Straight from the row now. Sealed in the database rather than carried in a
// cookie from the request that created the gallery, so it is here on the first
// load, the fiftieth, and in whatever browser she opens the panel in.
const password = readPassword(row);
---

<BaseLayout
  title={gallery.clientName}
  wide={true}
  crumbs={[
    { label: 'Galerie', href: '/admin' },
    { label: gallery.clientName, href: gallery.viewPath },
    { label: 'Edycja' },
  ]}
>
  <GalleryEditor
    client:load
    gallery={gallery}
    password={password}
    expiryChoices={EXPIRY_CHOICES}
    defaultExpiryDays={DEFAULT_EXPIRY_DAYS}
  />
</BaseLayout>
