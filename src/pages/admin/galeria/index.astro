---
/**
 * New gallery — the whole thing on one page.
 *
 * Details, link, password and drop zone together, rather than the two-step
 * wizard this replaced. The gallery row itself is created by the editor over
 * fetch, at the first moment there is something to create: she saves, or she
 * drops a folder in. Nothing is created by merely opening this page, so a
 * refresh or a back-then-forward leaves no orphan behind -- which is what the
 * old first step needed a Post/Redirect/Get dance to achieve.
 *
 * Once the gallery exists the editor rewrites the address bar to
 * /admin/g/<slug>, so from then on this tab is that gallery's own page: a
 * refresh reopens it, with the photos it already has.
 *
 * Which is also why the preparing banner is here. Dropping a folder creates
 * the gallery and starts the worker, and this screen -- rendered before either
 * existed -- had nothing to say about it: she was left on a page that looked
 * finished, with no way to know a refresh was what showed her the photos. The
 * banner picks the gallery up from the upload event instead, and the one
 * reload it eventually does lands on the address the editor already wrote.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryEditor from '../../../components/GalleryEditor.tsx';
import PreparingBanner from '../../../components/PreparingBanner.astro';
import { ADMIN_COOKIE, isAdmin } from '../../../../server/sessions.js';
import { EXPIRY_CHOICES, DEFAULT_EXPIRY_DAYS } from '../../../../server/gallery-form.js';
import '../../../styles/editor.css';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}
---

<BaseLayout
  title="Nowa galeria"
  wide={true}
  crumbs={[{ label: 'Galeria', href: '/admin' }, { label: 'Nowa galeria' }]}
>
  <GalleryEditor
    client:load
    gallery={null}
    password={null}
    expiryChoices={EXPIRY_CHOICES}
    defaultExpiryDays={DEFAULT_EXPIRY_DAYS}
    withUploader={true}
  />

  {/* Nothing to show until she drops something: no gallery, no worker, no
      numbers. It renders hidden and the first finished upload reveals it. */}
  <section class="preparing-slot">
    <PreparingBanner />
  </section>
</BaseLayout>

<style>
  /* The banner is a sibling of the editor's cards rather than a child of the
     island that draws them, so the gap they keep between themselves has to be
     stated here. */
  .preparing-slot { display: block; margin-top: 2rem; }
</style>
