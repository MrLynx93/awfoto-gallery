---
/**
 * The dashboard: which galleries are live, how much disk they are using, and
 * how long each has left.
 *
 * The disk bar is the point of this screen as much as the list is. 15 GB is the
 * project's real constraint, and `df` on this host reports the shared pool
 * rather than the account's quota — so the number here is the sum the
 * application keeps, and it is the only honest view of how close things are.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeleteGalleryConfirm from '../../components/DeleteGalleryConfirm.astro';
import { list, totalBytes } from '../../../server/galleries.js';
import { daysUntil } from '../../../server/gallery-form.js';
import { galleryAdminPath, galleryDeletePath } from '../../../server/paths.js';
import { megabytes, gigabytes, photoCount, dayCount } from '../../../server/format.js';
import { diskBudgetBytes } from '../../../server/config.js';
import { ADMIN_COOKIE, isAdmin } from '../../../server/sessions.js';

if (!isAdmin(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

// Set by the delete confirmation screen on its way back here. The row is
// simply gone, which is clear enough with one gallery in the list and not at
// all clear with nine, so it says so.
const justDeleted = Astro.url.searchParams.has('usunieto');

const galleries = await list();
const used = await totalBytes();
const usedFraction = Math.min(1, used / diskBudgetBytes);

---

<BaseLayout title="Panel" width="panel" crumbs={[{ label: 'Galeria' }]}>
  <header class="head">
    <h1>Galerie</h1>
    <a class="cta" href="/admin/galeria">Nowa galeria</a>
  </header>

  {
    justDeleted && (
      <p class="deleted" role="status">
        Galeria została usunięta razem ze zdjęciami.
      </p>
    )
  }

  <section class="disk" aria-label="Wykorzystanie dysku">
    <div class="disk-line">
      <span>{gigabytes(used)} z {gigabytes(diskBudgetBytes)}</span>
      <span class="muted">{Math.round(usedFraction * 100)}%</span>
    </div>
    <div class="bar">
      <div
        class="bar-fill"
        data-level={usedFraction > 0.9 ? 'critical' : usedFraction > 0.7 ? 'warning' : 'ok'}
        style={`width: ${Math.max(1, usedFraction * 100)}%`}
      />
    </div>
    <p class="muted small">
      Galerie kasują się same po upływie terminu. Jeśli robi się ciasno, usuń
      starszą sesję ręcznie.
    </p>
  </section>

  {
    galleries.length === 0 ? (
      <p class="empty">Nie ma jeszcze żadnej galerii. Zacznij od „Nowa galeria”.</p>
    ) : (
      /* Still more columns than a phone fits, and squeezing them makes the
         whole list unreadable rather than just the far end of it. */
      <div class="scroller">
      <table>
        <thead>
          <tr>
            {/* The row is a session; the client's name is how she recognises
                which one, and the date is just its date. Naming the first
                column "Klient" made the second one sound like a different
                thing entirely. */}
            <th>Sesja</th>
            {/* The phone drops the date: at that width the row has to answer
                "which session, how big, how long left" and nothing else, and the
                date is one tap away on the gallery. */}
            <th class="summary" />
            <th class="col-date">Data</th>
            <th>Zdjęcia</th>
            <th>Rozmiar</th>
            <th>Wygasa</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {galleries.map((gallery) => (
            <tr>
              <td>
                {/* Her own page for the gallery, not the client's link: /g
                    asks for the password, and she should not have to type a
                    client's code to look at photos she uploaded. It opens on
                    the details and the drop zone, so this is also the way in to
                    changing anything -- which is why there is no second link
                    beside it. */}
                <a href={galleryAdminPath(gallery.slug)}>{gallery.sessionName}</a>
              </td>
              {/* The phone's whole row, in words. Everything the columns say
                  beside it, said the way she would say it -- and built here
                  rather than assembled out of ::after text, because "1 zdjęcie"
                  and "5 zdjęć" are different words. Hidden on a wide screen,
                  where the columns say it better. */}
              <td class="summary">
                {photoCount(gallery.photoCount)}, {megabytes(gallery.bytesTotal)}.{' '}
                {gallery.expired
                  ? 'Termin minął.'
                  : `Wygasa za ${dayCount(daysUntil(gallery.expiresAt))}.`}
              </td>
              <td class="muted col-date">{gallery.sessionDate ?? '—'}</td>
              <td class="num col-count">{gallery.photoCount}</td>
              <td class="num col-size">{megabytes(gallery.bytesTotal)}</td>
              <td class={`col-expiry ${gallery.expired ? 'expired' : ''}`}>
                {gallery.expired ? 'wygasła' : `za ${dayCount(daysUntil(gallery.expiresAt))}`}
              </td>
              <td class="right actions">
                {/* One action here, not two. The name opens the gallery, and
                    that page is the editor, so a pencil beside it would go where
                    the row already goes. Deleting is the one thing that page
                    cannot be, so it keeps its own door -- and it opens the same
                    question the gallery's own page asks, in the same dialog,
                    without leaving the list. The href is the page version, for
                    before the script runs and for no JavaScript at all. */}
                <a
                  class="quiet danger"
                  href={galleryDeletePath(gallery.slug)}
                  data-usun={gallery.slug}
                  title="Usuń galerię razem ze zdjęciami"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4.5 6.8h15M9.8 6.8V4.6h4.4v2.2M6.8 6.8l.9 12.6h8.6l.9-12.6" />
                    <path d="M10.4 10.4v5.6M13.6 10.4v5.6" />
                  </svg>
                  <span class="label">Usuń</span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    )
  }

  {/* One per row, all of them after the table rather than inside its cells: a
      dialog is in the top layer wherever it is declared, and a table is a poor
      place to nest one. Each carries its own gallery's facts, which is what
      makes a modal safe here -- on a list of similar rows, the question has to
      repeat which one she picked. */}
  {
    galleries.map((gallery) => (
      <DeleteGalleryConfirm
        gallery={gallery}
        dialogId={`usun-${gallery.slug}`}
        action={galleryDeletePath(gallery.slug)}
        cancel={{ label: 'Nie, zostaw' }}
      />
    ))
  }
</BaseLayout>

{/* The bin opens the row's dialog. It stays a real link, so before this script
    runs -- and without JavaScript at all -- it still leads to the page that asks
    the same thing. */}
<script is:inline>
  document.addEventListener('click', (event) => {
    const trigger = event.target.closest('[data-usun]');
    if (!trigger) return;
    const dialog = document.getElementById(`usun-${trigger.dataset.usun}`);
    if (dialog instanceof HTMLDialogElement) {
      event.preventDefault();
      dialog.showModal();
    }
  });
</script>

<style>
  .head {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem;
  }
  .head h1 { margin: 0; }

  .cta {
    font-family: var(--body); font-size: 0.82rem; letter-spacing: 0.14em;
    text-transform: uppercase; padding: 1em 1.8em; border-radius: 3px;
    background: var(--glina); color: var(--biel); text-decoration: none;
    transition: background 0.25s;
  }
  .cta:hover { background: var(--glina-ciemna); }

  .disk { margin-bottom: 2.5rem; }
  .disk-line {
    display: flex; justify-content: space-between;
    font-size: 0.9rem; margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .bar { height: 6px; background: var(--piaskowy); border-radius: 999px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 999px; background: var(--szalwia); }
  .bar-fill[data-level='warning'] { background: var(--glina); }
  .bar-fill[data-level='critical'] { background: var(--glina-ciemna); }

  /* A last-resort escape hatch, not the plan: at phone width the table drops
     two columns and its buttons become icons instead, so it fits. This only
     catches the awkward middle -- a long client name on a narrow tablet. */
  .scroller { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th {
    text-align: left; font-weight: 500; font-size: 0.72rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--tekst-jasny);
    padding: 0 0.8rem 0.6rem; border-bottom: 1px solid var(--piaskowy);
  }
  td { padding: 0.85rem 0.8rem; border-bottom: 1px solid var(--bez); }
  td a { color: var(--tekst); text-decoration: none; border-bottom: 1px solid var(--taupe); }
  /* The icons only appear on a small screen; on a laptop the words say it
     better than any pictogram of a pencil. */
  td .quiet svg { display: none; }
  td a:hover { color: var(--glina-ciemna); }
  .num { font-variant-numeric: tabular-nums; }
  .right { text-align: right; white-space: nowrap; }
  /* `td a` above it is two elements' worth of specificity, so a bare .quiet
     lost to it and these links kept the client link's underline. */
  td a.quiet {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--tekst-jasny); text-decoration: none; border-bottom: 0;
  }
  td a.quiet:hover { color: var(--glina-ciemna); }
  /* Two actions in one cell need space between them. */
  .right .quiet + .quiet { margin-left: 1.1rem; }

  /* The one action in the row, and it deletes a wedding: a button rather than a
     word, outlined in the red used nowhere else in the panel, filling on hover.
     It still leads to a question -- see the dialog below the table. */
  td a.danger {
    padding: 0.55em 1.1em;
    border: 1px solid var(--czerwien);
    border-radius: 3px;
    color: var(--czerwien);
    line-height: 1.2;
    transition: background 0.25s, color 0.25s;
  }
  td a.danger:hover { background: var(--czerwien); color: var(--biel); }

  .deleted {
    background: #e7ece2; border: 1px solid #ccd6c4; border-radius: 4px;
    padding: 0.9rem 1.2rem; margin: 0 0 2rem; color: #55604a;
    font-size: 0.9rem;
  }
  .muted { color: var(--tekst-jasny); }
  .small { font-size: 0.82rem; margin-top: 0.7rem; }
  .expired { color: var(--glina-ciemna); }
  .empty { color: var(--tekst-jasny); padding: 3rem 0; text-align: center; }

  /* Only the phone reads this cell; a wide screen has the columns. */
  .summary { display: none; }

  /*
   * Phone: the table stops being a table.
   *
   * Six numeric columns squeezed into 360px made every client's name wrap over
   * three lines to spare four characters somewhere else. So each gallery
   * becomes a block instead -- the name on its own line, where it belongs, and
   * everything the columns were saying underneath it as one sentence: "3
   * zdjęcia, 240 MB. Wygasa za 30 dni." The two actions sit alongside as icons,
   * centred against both lines.
   *
   * The markup stays a real table, which is what it is; only its display
   * changes. That does mean the header row must go -- headings for columns that
   * are no longer laid out in columns would be nonsense, and the sentence names
   * its own values.
   */
  @media (max-width: 700px) {
    .scroller { overflow-x: visible; }
    thead { display: none; }
    table, tbody { display: block; width: 100%; }

    tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.15rem 1rem;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--bez);
    }

    td { display: block; padding: 0; border: 0; }
    .col-date, .col-count, .col-size, .col-expiry { display: none; }

    td:first-child { grid-column: 1; font-size: 1.02rem; }
    td:first-child a { border-bottom: 0; }

    .summary {
      display: block;
      grid-column: 1;
      font-size: 0.84rem;
      line-height: 1.5;
      color: var(--tekst-jasny);
    }

    /* Spanning both rows: one tap target per action, vertically centred against
       the pair of lines rather than pinned to the name. */
    .actions {
      grid-column: 2;
      grid-row: 1 / span 2;
      display: flex;
      align-items: center;
      /* Enough of a gap that a thumb aiming at the pencil does not find the
         bin, and no more: the wide layout's 1.1rem between the two words has
         to be cancelled, or the icons drift apart. */
      gap: 0.35rem;
    }
    .actions .quiet + .quiet { margin-left: 0; }

    td a.quiet {
      /* A finger, not a mouse: the icon is 18px and the padding around it is
         what makes the target big enough to hit. */
      padding: 0.5rem;
      margin: 0;
    }
    td .quiet svg {
      display: block;
      width: 19px; height: 19px;
      fill: none; stroke: currentColor; stroke-width: 1.4;
      stroke-linecap: round; stroke-linejoin: round;
    }
    /* Hidden, not removed: it is still the link's accessible name. */
    td .quiet .label {
      position: absolute; width: 1px; height: 1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }
    /* A finger cannot hover, so the bin is red where it sits -- and it is the
       icon alone here, without the outline the wide layout's button wears. */
    td a.danger {
      padding: 0.5rem;
      border: 0;
      color: var(--czerwien);
    }
  }
</style>
