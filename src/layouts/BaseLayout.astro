---
/**
 * The shell for every page.
 *
 * Deliberately leaner than awfoto-site's BaseLayout, which carries canonical
 * URLs, Open Graph tags and LocalBusiness schema. None of that belongs here:
 * every page is either a client's private gallery or an admin screen, so link
 * previews and structured data would be actively wrong. What carries over is
 * the brand — the same tokens, the same two self-hosted faces.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import type { Crumb } from '../components/SiteHeader.astro';

interface Props {
  title: string;
  /**
   * How much room the page takes.
   *
   * `text` is the reading column, for a page that is mostly words -- the gate,
   * the expired notice, the login. `panel` is the site's own measure, which the
   * admin screens keep because a form field or a table row gains nothing from
   * being 1800px wide. `photos` is the client's gallery, which is a page of
   * photographs and nothing else: there the width is what the photographs are
   * printed at, so it takes as much of the screen as the shell's own gutters
   * allow.
   */
  width?: 'text' | 'panel' | 'photos';
  /**
   * The breadcrumb trail, and whether to draw the header bar at all.
   *
   * An empty array still draws the bar with just the mark -- which is what the
   * login screen and the client's gallery want: both are one page with nowhere
   * to go back to. Omitting the prop entirely leaves a page bare.
   */
  crumbs?: Crumb[];
  /** Passed through to the header: where its wordmark leads. */
  homeHref?: string;
}

const { title, width = 'text', crumbs, homeHref } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — AW Fotografia</title>

    <!-- Self-hosted, so no third-party request and no consent question. Both
         faces are split latin / latin-ext by unicode-range: Polish diacritics
         live in latin-ext, so this page fetches both and an ASCII one does not. -->
    <link
      rel="preload"
      href="/fonts/jost-300.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    {crumbs && <SiteHeader crumbs={crumbs} home={homeHref} />}

    <main class={width}>
      <slot />
    </main>

    <footer>
      <p>AW Fotografia</p>
    </footer>

    <style>
      main {
        width: 100%;
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) var(--pad-x);
      }
      main.text {
        max-width: 46rem;
      }
      /* Far past the site's measure, because nothing on this page is read
         across it: it holds a title, one line about the expiry date, and the
         photographs. The cap is only there so that a very wide monitor sets
         that one line across half a metre. */
      main.photos {
        max-width: 1800px;
      }
      footer {
        padding: 2rem var(--pad-x);
        text-align: center;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--tekst-jasny);
        border-top: 1px solid var(--piaskowy);
      }
      footer p {
        margin: 0;
      }
    </style>
  </body>
</html>
