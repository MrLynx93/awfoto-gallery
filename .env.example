# Copy to `.env` ON THE SERVER — never commit the real one.
#
#   ~/domains/galeria.aw-foto.pl/public_nodejs/.env      chmod 600
#
# The deploy rsync excludes `.env`, so it survives every deploy. It is only
# needed once there is an app to read it (Milestone 1) — the Milestone 0/1 host
# checks do not use it.

# --- Database -----------------------------------------------------------
# Read these back from `devil mysql list -v`, NOT from what you typed:
# mydevil commonly prefixes both names with the account login.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Secrets ------------------------------------------------------------
# Signs the admin session cookie. Generate with: openssl rand -hex 32
# Changing it logs the admin out; it only has to be stable, not memorable.
SESSION_SECRET=

# scrypt hash of the admin password. Do NOT type a plaintext password here.
# Generate with `npm run admin:password`, which prompts and prints this line.
ADMIN_PASSWORD_HASH=

# --- Storage ------------------------------------------------------------
# `df` reports the shared ZFS pool (1.1 TB free), not the account quota, so the
# guard is this number plus the per-gallery byte tally in the database.
DISK_BUDGET_GB=12

# Everything: originals, previews, ZIPs, and in-progress tus uploads.
#
# This path MUST NOT be under ~/domains/ — nothing here is web-served. Every
# byte reaches a client through an authenticated Node route that checks the
# gallery session and expiry first. A second vhost serving these files was
# designed and then rejected: the files must not be browsable, and an
# unguessable URL is still a URL.
STORAGE_ROOT=/usr/home/MrLynx93/galeria-storage

# --- Locale -------------------------------------------------------------
# Load-bearing, not decoration. The host locale is `C`; without this, `zip`
# does not flag Polish filenames as UTF-8 and `Zażółć.jpg` reaches the client
# as mojibake on Windows.
LANG=pl_PL.UTF-8

PUBLIC_BASE_URL=https://galeria.aw-foto.pl
